{
  "name": "chimein",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --test --import tsx server/test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "unpdf": "^1.9.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
