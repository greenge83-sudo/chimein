# ===== 部署区域：global（海外区）或 cn（中国大陆区）。两区分开部署、数据不互通 =====
DEPLOY_REGION=global
PORT=8787
# 对外访问地址（用于生成会议链接/二维码），例如 https://chimein.example.com
PUBLIC_URL=http://localhost:5173
DATA_DIR=./data

# ===== 大模型（按环节路由，见需求文档 6.3）=====
# provider: anthropic | openai_compat | mock（mock 不调用任何外部服务，用于本地演示）
LLM_JUDGE_PROVIDER=mock
LLM_GENERATE_PROVIDER=mock
LLM_MINUTES_PROVIDER=mock
# 海外区默认模型
LLM_JUDGE_MODEL=claude-haiku-5-5
LLM_GENERATE_MODEL=claude-sonnet-5-5
LLM_MINUTES_MODEL=claude-opus-5-5
# 失败时切换的备用 provider/模型（可选）
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
# OpenAI 兼容接口（DeepSeek / GLM / Qwen / Kimi / MiniMax 等大陆区模型）
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPAT_API_KEY=

# ===== 联网搜索 =====
# provider: tavily | bocha | mock
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
BOCHA_API_KEY=

# ===== 流式语音识别 =====
# provider: browser（主持人浏览器自带识别，免费、无说话人分离，仅用于试用）| soniox | assemblyai | none
ASR_PROVIDER=browser
SONIOX_API_KEY=
ASSEMBLYAI_API_KEY=

# ===== 向量模型（复述识别）=====
# provider: local（本地字符 n-gram，不支持跨语言）| openai_compat
EMBED_PROVIDER=local
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
